class Solution {
    public int minimumCost(int x, int s, int m, int l, int cs, int cm, int cl) {
        // code here
        int minCost = Integer.MAX_VALUE;

        // Number of small pizzas
        for (int i = 0; i <= x / s + 1; i++) {

            // Number of medium pizzas
            for (int j = 0; j <= x / m + 1; j++) {

                // Number of large pizzas
                for (int k = 0; k <= x / l + 1; k++) {

                    int area = i * s + j * m + k * l;

                    if (area >= x) {
                        int cost = i * cs + j * cm + k * cl;
                        minCost = Math.min(minCost, cost);
                    }
                }
            }
        }

        return minCost;
    }
}